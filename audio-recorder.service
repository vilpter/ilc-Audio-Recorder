[Unit]
Description=Audio Recorder - Dual-Mono Recording System
After=network-online.target sound.target
Wants=network-online.target

# Installed by install.sh to /etc/systemd/system/audio-recorder.service and
# overwritten on every install/upgrade. Put local customizations in a drop-in:
#   sudo systemctl edit audio-recorder

[Service]
Type=simple
User=audio-recorder
Group=audio-recorder
# ALSA capture devices (/dev/snd/*)
SupplementaryGroups=audio

WorkingDirectory=/opt/audio-recorder/app
ExecStart=/opt/audio-recorder/.venv/bin/python /opt/audio-recorder/app/app.py

# Runtime locations (see config.py)
Environment=AUDIO_RECORDER_STATE_DIR=/var/lib/audio-recorder
Environment=AUDIO_RECORDER_LOG_DIR=/var/log/audio-recorder
Environment=AUDIO_RECORDER_SERVICE_LOG_DIR=/var/log/audio-recorder
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1

# systemd creates these and keeps them owned by the service account
StateDirectory=audio-recorder
StateDirectoryMode=0750
LogsDirectory=audio-recorder
LogsDirectoryMode=0750

# Restart policy
Restart=always
RestartSec=10

# Logging: the app writes its own size-limited logs (app, error, recorder,
# scheduler, ffmpeg) to /var/log/audio-recorder. Anything printed to the console,
# such as a crash during startup, goes to the journal:
#   journalctl -u audio-recorder
# For verbose logs:  sudo systemctl edit audio-recorder  and add
#   [Service]
#   Environment=AUDIO_RECORDER_LOG_LEVEL=DEBUG

# Hardening. ProtectSystem=full makes /usr, /boot and /etc read-only. It is not
# "strict", and ProtectHome is not set, because the recordings directory is a
# user setting and may live anywhere the service account can write.
#
# Seccomp-based options (RestrictSUIDSGID, LockPersonality, ProtectKernelTunables,
# ProtectKernelModules) are deliberately omitted: with systemd 257+ they require
# CAP_SYS_ADMIN at startup and keep the service from starting in containers, LXC
# and other environments where systemd lacks full privileges.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectControlGroups=true
UMask=0002

# Resource limits
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
